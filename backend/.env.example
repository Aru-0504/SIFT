# PostgreSQL connection string from Supabase Project Settings > Database > Connection string.
# URL-encode special characters in the password, for example @ becomes %40.
# Leave this unset for local SQLite development.
DATABASE_URL=
# development, test, or production
APP_ENV=development
MARKET_DATA_API_KEY=replace-with-your-twelve-data-key
# Comma-separated browser origins. Do not use * when credentials are enabled.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174
# Supabase JWT secret, used to verify incoming access tokens.
# Found at: Project Settings > API > JWT Secret. Never commit the real value.
SUPABASE_JWT_SECRET=replace-with-your-project-jwt-secret

# Cache TTL for market quotes, in seconds
QUOTE_CACHE_TTL_SECONDS=45

